#!/bin/sh
# Checks skills.yaml, then runs the tests of the repo scripts, of each skill and of each tool the commit touches (all of them when it touches lib/).
# The selection and the runs live in scripts/precommit.py, which runs the suites at once (SKILLS_PRECOMMIT_JOBS, default 4).
# Enable per clone: see SETUP.md.
root=$(git rev-parse --show-toplevel)
staged=$(git diff --cached --name-only)
# Tests may run git in temp repos: past this point, keep them off the index being committed.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
py() { uv run -q --no-project --with pyyaml python "$@"; }

if ! out=$(py "$root/scripts/skills.py" --root "$root" validate 2>&1); then
  printf 'pre-commit: skills.yaml check failed\n%s\n' "$out" >&2
  exit 1
fi

# The staged paths go on stdin: read after the unset above, git would see another index.
printf '%s\n' "$staged" | py "$root/scripts/precommit.py" --root "$root"
